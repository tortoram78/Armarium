# Armarium environment (v0 = single fixed user + one-password gate)
# Copy to .env.local (Next) / .env (scripts) and fill in.

# Postgres on Supabase (Drizzle). Required for db:migrate / db:seed and runtime DB access.
DATABASE_URL=postgres://user:password@host:5432/postgres

# Anthropic — SERVER ONLY. Required to run the real classification pipeline / seed.
ANTHROPIC_API_KEY=sk-ant-xxxx
# Optional override of the API base URL.
# ANTHROPIC_BASE_URL=

# v0 one-password gate (not real auth).
APP_PASSWORD=changeme
# The single fixed user id used for all v0 rows.
ARMARIUM_USER_ID=00000000-0000-0000-0000-000000000001
